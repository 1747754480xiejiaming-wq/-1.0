# Copy to .env. Keys stay on the API / bot processes only.
API_HOST=127.0.0.1
API_PORT=3001
WEB_HOST=127.0.0.1
WEB_PORT=8080
DATABASE_PATH=data/campus.db
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=0
QUESTION_RATE_LIMIT=10
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.3-flash
# 智谱官方视觉模型。文本模型与视觉模型分开配置。
ZHIPU_VISION_MODEL=glm-4.6v-flash
DEEPSEEK_TIMEOUT_MS=15000
MODEL_CONCURRENCY=2
MODEL_DAILY_LIMIT=500
CAMPUS_DEVELOPER_USERNAME=developer
# Leave these blank to generate unique local values during npm run setup.
CAMPUS_DEVELOPER_PASSWORD=
CAMPUS_REGISTRATION_CODE=
CAMPUS_DEVELOPER_KEY=
# setup generates a random token if omitted. Never prefix it with VITE_.
BOT_API_TOKEN=
QQBOT_CREDENTIALS_FILE=
BOT_API_BASE_URL=http://127.0.0.1:3001
VITE_API_BASE_URL=/api/v1
